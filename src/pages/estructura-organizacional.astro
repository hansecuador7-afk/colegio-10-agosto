---
import { getCollection } from 'astro:content';

import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import {
  CATEGORIAS_CUADRO_HONOR,
  PUESTOS_CUADRO_HONOR,
  esPuestoPrincipal,
} from '../data/cuadroHonor';
import { AREAS_ESTRUCTURA, areaInfo } from '../data/estructura';

const integrantes = await getCollection('estructura');
const estudiantesCuadroHonor = await getCollection('cuadroHonor');

const grupos = AREAS_ESTRUCTURA.map((area) => ({
  area,
  ...areaInfo[area],
  personas: integrantes
    .filter((integrante) => integrante.data.area === area)
    .sort((a, b) => a.data.title.localeCompare(b.data.title, 'es')),
}));

const gruposConIntegrantes = grupos.filter((grupo) => grupo.personas.length > 0);

const estudiantesCuadroHonorOrdenados = [...estudiantesCuadroHonor].sort(
  (a, b) =>
    PUESTOS_CUADRO_HONOR.indexOf(a.data.puesto) -
    PUESTOS_CUADRO_HONOR.indexOf(b.data.puesto),
);

const categoriasCuadroHonor = CATEGORIAS_CUADRO_HONOR.map((categoria) => ({
  ...categoria,
  estudiantes: estudiantesCuadroHonorOrdenados.filter((estudiante) =>
    categoria.puestos.includes(estudiante.data.puesto),
  ),
}));
---

<MainLayout
  title="Estructura organizacional"
  description="Conoce la estructura organizacional de la Unidad Educativa Fiscomisional 10 de Agosto, sus áreas de trabajo y el Cuadro de Honor 2026-2027."
>
  <PageHero
    eyebrow="Estructura organizacional"
    breadcrumb="Estructura organizacional"
    title="Áreas que trabajan por una misma comunidad"
    description="Nuestra organización permite acompañar a las y los estudiantes desde la dirección, la gestión académica, el bienestar y la participación estudiantil."
    image="/assets/fotos/IMG_5044.jpg"
    imageAlt="Docentes con vestimenta institucional en el patio del colegio"
  />

  <!-- Áreas de la estructura -->
  <section class="bg-white py-16 sm:py-20 lg:py-24">
    <div class="container-site">
      <SectionHeading
        eyebrow="Cómo nos organizamos"
        title="Un equipo en diálogo con toda la comunidad"
        description="Cada área cumple una función específica para sostener la formación integral, la convivencia y el bienestar de quienes forman parte de la institución."
      />

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          grupos.map((grupo, index) => (
            <article
              class="group relative overflow-hidden rounded-3xl border border-stone-200 bg-white p-6 shadow-sm shadow-stone-900/5 transition duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-lg sm:p-7"
              data-reveal
              style={`--reveal-delay: ${(index % 3) * 70}ms`}
            >
              <div class="flex items-start justify-between gap-4">
                <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 transition duration-300 group-hover:bg-brand-700 group-hover:text-white">
                  <Icon name={grupo.icon} class="h-5 w-5" />
                </span>
                <span class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-stone-300">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>
              <h2 class="mt-6 text-xl leading-tight">{grupo.area}</h2>
              <p class="mt-2 text-sm leading-relaxed text-stone-500">{grupo.description}</p>
              {
                grupo.personas.length > 0 && (
                  <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-stone-200 bg-stone-50 px-3 py-1.5 text-[9px] font-extrabold uppercase tracking-[0.12em] text-stone-500">
                    <Icon name="users" class="h-3.5 w-3.5 text-brand-600" />
                    {grupo.personas.length} {grupo.personas.length === 1 ? 'integrante' : 'integrantes'}
                  </p>
                )
              }
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cuadro de Honor -->
  <section id="cuadro-de-honor" class="relative overflow-hidden bg-brand-950 py-16 text-white sm:py-20 lg:py-24">
    <div class="absolute inset-0 bg-ray-pattern opacity-30" aria-hidden="true"></div>
    <div class="absolute -right-40 top-10 h-96 w-96 rounded-full bg-brand-600/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -left-40 bottom-0 h-96 w-96 rounded-full bg-sun-400/10 blur-3xl" aria-hidden="true"></div>

    <div class="container-site relative">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionHeading
          eyebrow="Excelencia y compromiso"
          title="Cuadro de Honor 2026-2027"
          description="Reconocemos a las y los estudiantes que, con esfuerzo, disciplina y sentido de pertenencia, representan con orgullo a nuestra institución."
          light
        />
        <span class="inline-flex shrink-0 items-center gap-2 self-start rounded-full border border-white/15 bg-white/5 px-4 py-2 text-[10px] font-extrabold uppercase tracking-[0.16em] text-white/60 md:self-auto">
          <Icon name="award" class="h-4 w-4 text-sun-300" />
          Periodo lectivo 2026-2027
        </span>
      </div>

      <div class="mt-10 space-y-5 sm:mt-12 sm:space-y-6">
        {
          categoriasCuadroHonor.map((categoria, index) => (
            <article
              class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-stone-950/60 shadow-2xl shadow-stone-950/30"
              data-reveal
              style={`--reveal-delay: ${index * 80}ms`}
            >
              <img
                src={categoria.flag}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover opacity-[0.12]"
              />
              <div class="absolute inset-0 bg-gradient-to-r from-stone-950 via-stone-950/90 to-stone-950/55" aria-hidden="true"></div>
              <div class={`absolute -right-24 -top-24 h-64 w-64 rounded-full blur-3xl ${categoria.glowClass}`} aria-hidden="true"></div>

              <div class="relative p-5 sm:p-7 lg:p-8">
                <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-5">
                  <div class="flex items-center gap-4">
                    <span class="shrink-0 overflow-hidden rounded-xl border border-white/25 bg-white shadow-lg shadow-stone-950/30">
                      <img
                        src={categoria.flag}
                        alt={categoria.flagAlt}
                        width="72"
                        height="48"
                        loading="lazy"
                        decoding="async"
                        class="h-12 w-[4.5rem] object-cover"
                      />
                    </span>
                    <div>
                      <p class={`text-[10px] font-extrabold uppercase tracking-[0.18em] ${categoria.accentText}`}>
                        Categoría
                      </p>
                      <h3 class="mt-1 text-xl text-white sm:text-2xl">{categoria.title}</h3>
                      <p class="mt-1 text-xs leading-relaxed text-white/55">{categoria.description}</p>
                    </div>
                  </div>
                  <span class={`inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-[9px] font-extrabold uppercase tracking-[0.12em] ${categoria.badgeClass}`}>
                    <Icon name="users" class="h-3.5 w-3.5" />
                    {categoria.estudiantes.length} de {categoria.puestos.length} puestos publicados
                  </span>
                </div>

                {
                  categoria.estudiantes.length > 0 ? (
                    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                      {categoria.estudiantes.map((estudiante) => (
                        <article
                          class:list={[
                            'group relative overflow-hidden rounded-2xl border bg-white/[0.06] backdrop-blur transition duration-300 hover:-translate-y-1 hover:bg-white/[0.09]',
                            esPuestoPrincipal(estudiante.data.puesto)
                              ? 'border-sun-300/40 shadow-lg shadow-sun-400/10'
                              : 'border-white/10 hover:border-white/25',
                          ]}
                        >
                          <div class="photo-frame relative aspect-[4/5] bg-stone-900">
                            <img
                              src={estudiante.data.foto}
                              alt={`Fotografía de ${estudiante.data.nombre}`}
                              loading="lazy"
                              decoding="async"
                              class="h-full w-full object-cover"
                            />
                            {esPuestoPrincipal(estudiante.data.puesto) && (
                              <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-sun-400 px-2.5 py-1 text-[8px] font-extrabold uppercase tracking-[0.12em] text-brand-950 shadow-lg shadow-stone-950/20">
                                <Icon name="award" class="h-3 w-3" />
                                Principal
                              </span>
                            )}
                          </div>
                          <div class="p-4 sm:p-5">
                            <p class={`text-[8.5px] font-extrabold uppercase tracking-[0.14em] ${categoria.accentText}`}>
                              Puesto
                            </p>
                            <p class="mt-1 text-sm font-bold leading-snug text-white">{estudiante.data.puesto}</p>
                            <h4 class="mt-3 text-lg leading-tight text-white">{estudiante.data.nombre}</h4>
                            <p class="mt-3 inline-flex max-w-full items-center gap-2 rounded-full border border-white/10 bg-white/10 px-3 py-1.5 text-[9px] font-extrabold uppercase tracking-[0.12em] text-white/60">
                              <Icon name="award" class="h-3.5 w-3.5 shrink-0 text-sun-300" />
                              Puntaje
                              <span class={`text-sm normal-case tracking-normal ${categoria.accentText}`}>
                                {estudiante.data.puntaje}
                              </span>
                            </p>
                          </div>
                        </article>
                      ))}
                    </div>
                  ) : (
                    <div class="mt-6 rounded-2xl border border-dashed border-white/15 bg-stone-950/60 px-6 py-10 text-center backdrop-blur-sm">
                      <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white/50">
                        <Icon name="award" class="h-5 w-5" />
                      </span>
                      <p class="mt-4 text-sm font-bold text-white/75">
                        Aún no se han publicado los estudiantes de esta categoría.
                      </p>
                      <p class="mt-1 text-xs text-white/45">
                        Pronto se compartirán los nombres de quienes representan esta bandera.
                      </p>
                    </div>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Integrantes agrupados por área -->
  {
    gruposConIntegrantes.length > 0 ? (
      <section class="bg-cream py-16 sm:py-20 lg:py-24">
        <div class="container-site">
          <SectionHeading
            eyebrow="Nuestro equipo"
            title="Las personas detrás de cada área"
            description="Conoce a quienes acompañan la vida institucional desde sus distintas responsabilidades y cargos."
          />

          <div class="mt-12 space-y-14 sm:space-y-16">
            {gruposConIntegrantes.map((grupo) => (
              <section>
                <div class="flex flex-col gap-3 border-b border-stone-200 pb-5 sm:flex-row sm:items-end sm:justify-between">
                  <div class="flex items-center gap-4">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-brand-700 text-white">
                      <Icon name={grupo.icon} class="h-5 w-5" />
                    </span>
                    <div>
                      <p class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-brand-700">Área</p>
                      <h2 class="mt-1 text-2xl sm:text-3xl">{grupo.area}</h2>
                    </div>
                  </div>
                  <p class="text-[10px] font-extrabold uppercase tracking-[0.14em] text-stone-400">
                    {grupo.personas.length} {grupo.personas.length === 1 ? 'integrante' : 'integrantes'}
                  </p>
                </div>

                <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                  {grupo.personas.map((integrante, index) => (
                    <article
                      class="group overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm shadow-stone-900/5 transition duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-lg"
                      data-reveal
                      style={`--reveal-delay: ${(index % 4) * 60}ms`}
                    >
                      <div class="photo-frame aspect-[4/5] bg-stone-100">
                        <img
                          src={integrante.data.image}
                          alt={`Fotografía de ${integrante.data.title}, ${integrante.data.cargo}`}
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-cover"
                        />
                      </div>
                      <div class="p-5">
                        <p class="text-[9px] font-extrabold uppercase leading-relaxed tracking-[0.14em] text-brand-700">
                          {integrante.data.cargo}
                        </p>
                        <h3 class="mt-2 text-lg leading-tight">{integrante.data.title}</h3>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </section>
    ) : (
      <section class="bg-cream py-16 sm:py-20">
        <div class="container-site">
          <div class="mx-auto max-w-2xl rounded-[2rem] border border-dashed border-stone-300 bg-white p-8 text-center shadow-sm shadow-stone-900/5 sm:p-10" data-reveal>
            <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-50 text-brand-700">
              <Icon name="users" class="h-7 w-7" />
            </span>
            <h2 class="mt-5 text-2xl">Estamos actualizando nuestros perfiles</h2>
            <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-stone-500">
              Muy pronto publicaremos aquí a las personas que integran las distintas áreas de nuestra estructura organizacional.
            </p>
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    title="Una estructura al servicio de la formación."
    description="Conoce las etapas educativas y toda la información de matrícula y pensiones de nuestra institución."
    primaryLabel="Ver oferta académica"
    primaryHref="/oferta"
    secondaryLabel="Matrícula y pensiones"
    secondaryHref="/matricula-y-pensiones"
  />
</MainLayout>
