---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { photos } from '../data/photos';
import { site } from '../data/site';

const mission =
  'Ser una institución educativa emblemática e inclusiva que transforma a la comunidad con innovaciones curriculares, desarrollando lo académico, la cultura, el arte, la educación física y recreacional de la niñez y juventud para su inserción en el mundo actual, considerando la realidad socioeconómica.';

const vision =
  'Formar estudiantes críticos, analíticos, responsables y cuestionadores de la realidad que los rodea y del saber científico, tecnológico y artístico, con énfasis en la participación de soluciones comunitarias mediante una capacitación integral.';

const pillars = [
  {
    icon: 'sparkles',
    title: 'Formación integral',
    description: 'Lo académico, la cultura, el arte, la educación física y la recreación forman parte de un mismo camino.',
  },
  {
    icon: 'heart',
    title: 'Inclusión',
    description: 'Una institución emblemática que busca transformar a la comunidad y abrir oportunidades para todas y todos.',
  },
  {
    icon: 'compass',
    title: 'Innovación curricular',
    description: 'Buscamos nuevas formas de enseñar y aprender, atentas a la realidad de nuestra comunidad.',
  },
  {
    icon: 'users',
    title: 'Compromiso comunitario',
    description: 'Formamos estudiantes que participan en la construcción de soluciones para su entorno.',
  },
];

const galleryMosaic = [photos[7], photos[34], photos[0]];
---

<MainLayout
  title="Nosotros"
  description="Conoce la historia, misión y visión de la Unidad Educativa Fiscomisional 10 de Agosto. 63 años sembrando formación integral en San Lorenzo, Esmeraldas."
>
  <PageHero
    eyebrow="Nosotros"
    breadcrumb="Nosotros"
    title="Una historia que florece desde hace 63 años"
    description="Somos una comunidad educativa fiscomisional que siembra conocimiento, valores y oportunidades en el corazón de San Lorenzo."
    image="/assets/fotos/IMG_5043.jpg"
    imageAlt="Estudiantes uniformados formados en el patio del colegio"
  />

  <!-- Presentación y trayectoria -->
  <section class="bg-white py-16 sm:py-20 lg:py-24">
    <div class="container-site grid items-start gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div class="relative" data-reveal>
        <div class="relative overflow-hidden rounded-[2rem] bg-brand-700 p-8 text-white shadow-xl shadow-brand-950/15 sm:p-10">
          <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full border-[24px] border-sun-400/20" aria-hidden="true"></div>
          <p class="font-display text-7xl font-semibold leading-none text-sun-300 sm:text-8xl">63</p>
          <p class="mt-3 text-[10px] font-extrabold uppercase tracking-[0.2em] text-white/60">Años de trayectoria</p>
          <p class="mt-5 text-sm leading-relaxed text-white/75">
            Una historia construida junto a generaciones de estudiantes, familias y docentes que han hecho del colegio su segundo hogar.
          </p>
          <div class="mt-7 flex items-center gap-2 border-t border-white/15 pt-5 text-[10px] font-bold uppercase tracking-[0.14em] text-sun-300">
            <Icon name="leaf" class="h-4 w-4" />
            {site.motto}
          </div>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-4">
          <div class="rounded-2xl border border-stone-200 bg-cream p-4">
            <Icon name="map-pin" class="h-5 w-5 text-brand-600" />
            <p class="mt-3 text-xs font-extrabold text-stone-800">San Lorenzo</p>
            <p class="mt-1 text-[11px] leading-relaxed text-stone-500">Esmeraldas, Ecuador</p>
          </div>
          <div class="rounded-2xl border border-stone-200 bg-sun-50 p-4">
            <Icon name="school" class="h-5 w-5 text-sun-700" />
            <p class="mt-3 text-xs font-extrabold text-stone-800">Fiscomisional</p>
            <p class="mt-1 text-[11px] leading-relaxed text-stone-500">Formación con identidad y compromiso</p>
          </div>
        </div>
      </div>

      <div data-reveal style="--reveal-delay: 100ms">
        <span class="eyebrow">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-600" aria-hidden="true"></span>
          Nuestra identidad
        </span>
        <h2 class="mt-5 text-3xl leading-[1.06] sm:text-4xl lg:text-5xl">
          Una comunidad que aprende, comparte y siembra.
        </h2>
        <div class="mt-6 space-y-4 text-sm leading-7 text-stone-600 sm:text-base sm:leading-8">
          <p>
            Durante 63 años, la Unidad Educativa Fiscomisional 10 de Agosto ha acompañado a la niñez y juventud de San Lorenzo con una formación integral que abraza lo académico, la cultura, el arte, la educación física y lo recreacional.
          </p>
          <p>
            Somos una institución inclusiva y cercana, que valora la realidad socioeconómica de su comunidad y trabaja para que cada estudiante encuentre en la educación una oportunidad para crecer y transformar su entorno.
          </p>
        </div>

        <blockquote class="mt-8 rounded-3xl border border-brand-100 bg-brand-50 p-6 sm:p-7">
          <div class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white text-brand-700 shadow-sm">
              <Icon name="quote" class="h-5 w-5" />
            </span>
            <div>
              <p class="font-display text-2xl italic leading-snug text-brand-900">“Siempre sembrando”</p>
              <p class="mt-2 text-sm leading-relaxed text-stone-500">
                Sembrar es confiar en el futuro. Es acompañar, cuidar y dar tiempo para que cada talento florezca.
              </p>
            </div>
          </div>
        </blockquote>

        <a href="/oferta" class="group mt-7 inline-flex items-center gap-2 text-sm font-extrabold text-brand-700 transition hover:text-brand-900">
          Descubre nuestra oferta académica
          <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
        </a>
      </div>
    </div>
  </section>

  <!-- Misión y visión -->
  <section class="bg-cream py-16 sm:py-20 lg:py-24">
    <div class="container-site">
      <SectionHeading
        eyebrow="Nuestro norte"
        title="Misión y visión que guían cada paso"
        description="Dos compromisos que sostienen nuestra tarea educativa y dan sentido a nuestra vida institucional."
        center
      />

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        <article class="group relative overflow-hidden rounded-3xl border border-stone-200 bg-white p-7 shadow-sm shadow-stone-900/5 transition duration-300 hover:border-brand-200 hover:shadow-lg sm:p-9" data-reveal>
          <div class="absolute inset-x-0 top-0 h-1.5 bg-brand-700" aria-hidden="true"></div>
          <div class="flex items-center gap-4">
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 transition group-hover:bg-brand-700 group-hover:text-white">
              <Icon name="compass" class="h-6 w-6" />
            </span>
            <div>
              <p class="text-[10px] font-extrabold uppercase tracking-[0.18em] text-stone-400">Nuestra</p>
              <h2 class="mt-1 text-2xl">Misión</h2>
            </div>
          </div>
          <p class="mt-6 text-sm leading-7 text-stone-600 sm:text-[15px] sm:leading-8">{mission}</p>
          <div class="mt-6 flex items-center gap-2 text-[10px] font-extrabold uppercase tracking-[0.14em] text-brand-700">
            <Icon name="leaf" class="h-4 w-4" />
            Transformar desde la educación
          </div>
        </article>

        <article class="group relative overflow-hidden rounded-3xl border border-stone-200 bg-white p-7 shadow-sm shadow-stone-900/5 transition duration-300 hover:border-sun-300 hover:shadow-lg sm:p-9" data-reveal style="--reveal-delay: 100ms">
          <div class="absolute inset-x-0 top-0 h-1.5 bg-sun-400" aria-hidden="true"></div>
          <div class="flex items-center gap-4">
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-sun-100 text-sun-700 transition group-hover:bg-sun-400 group-hover:text-brand-950">
              <Icon name="eye" class="h-6 w-6" />
            </span>
            <div>
              <p class="text-[10px] font-extrabold uppercase tracking-[0.18em] text-stone-400">Nuestra</p>
              <h2 class="mt-1 text-2xl">Visión</h2>
            </div>
          </div>
          <p class="mt-6 text-sm leading-7 text-stone-600 sm:text-[15px] sm:leading-8">{vision}</p>
          <div class="mt-6 flex items-center gap-2 text-[10px] font-extrabold uppercase tracking-[0.14em] text-sun-700">
            <Icon name="eye" class="h-4 w-4" />
            Formar para el mundo actual
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Pilares -->
  <section class="bg-white py-16 sm:py-20 lg:py-24">
    <div class="container-site">
      <SectionHeading
        eyebrow="Lo que nos define"
        title="Pilares de nuestra comunidad"
        description="La misión y la visión se viven todos los días en la manera en que enseñamos, acompañamos y compartimos."
      />

      <div class="mt-10 grid gap-x-6 gap-y-7 sm:grid-cols-2 lg:grid-cols-4">
        {
          pillars.map((pillar, index) => (
            <div class="group" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 transition duration-300 group-hover:bg-brand-700 group-hover:text-white">
                <Icon name={pillar.icon} class="h-5 w-5" />
              </span>
              <h3 class="mt-5 text-lg leading-tight">{pillar.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-500">{pillar.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Momentos -->
  <section class="bg-cream py-16 sm:py-20 lg:py-24">
    <div class="container-site">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <SectionHeading
          eyebrow="Así se vive"
          title="Nuestra historia también se cuenta en imágenes"
          description="Encuentros, tradiciones y celebraciones que forman parte de la memoria de nuestra comunidad."
        />
        <a href="/galeria" class="group inline-flex shrink-0 items-center gap-2 self-start text-sm font-extrabold text-brand-700 transition hover:text-brand-900 md:self-auto">
          Ver la galería completa
          <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
        </a>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-[1.15fr_0.85fr]">
        <a href="/galeria" class="group photo-frame relative block rounded-3xl" data-reveal>
          <div class="aspect-[4/3] sm:aspect-auto sm:h-full sm:min-h-[28rem]">
            <img src={galleryMosaic[0].src} alt={galleryMosaic[0].alt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/80 via-transparent to-transparent" aria-hidden="true"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-6">
            <div>
              <p class="text-[9px] font-extrabold uppercase tracking-[0.18em] text-sun-300">Cultura y arte</p>
              <p class="mt-1.5 font-display text-xl text-white sm:text-2xl">Tradiciones que nos unen</p>
            </div>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/20 bg-white/10 text-white backdrop-blur transition group-hover:bg-sun-400 group-hover:text-brand-950">
              <Icon name="arrow-up-right" class="h-4 w-4" />
            </span>
          </div>
        </a>

        <div class="grid gap-4 sm:grid-rows-2">
          {
            galleryMosaic.slice(1).map((photo, index) => (
              <a
                href="/galeria"
                class="group photo-frame relative block rounded-3xl"
                data-reveal
                style={`--reveal-delay: ${(index + 1) * 90}ms`}
              >
                <div class="aspect-[16/10] sm:h-full">
                  <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-stone-950/75 via-transparent to-transparent" aria-hidden="true"></div>
                <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-5">
                  <p class="font-display text-lg leading-tight text-white">{photo.caption}</p>
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/20 bg-white/10 text-white backdrop-blur transition group-hover:bg-sun-400 group-hover:text-brand-950">
                    <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Queremos que conozcas el camino que hemos preparado para ti."
    description="Explora nuestra oferta académica y descubre cómo acompañamos cada etapa de la formación."
    primaryLabel="Ver oferta académica"
    primaryHref="/oferta"
    secondaryLabel="Hablar con nosotros en Facebook"
    secondaryHref={site.facebook}
    secondaryExternal
  />
</MainLayout>
