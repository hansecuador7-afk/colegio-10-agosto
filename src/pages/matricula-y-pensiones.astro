---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { getMatriculaYPensionesData } from '../lib/paginas';
import { site } from '../data/site';

const info = await getMatriculaYPensionesData();
const estaAbierta = info.estado === 'abiertas';

const niveles = [
  {
    title: 'Inicial a 10mo',
    description: 'Educación Inicial, Preparatoria y Educación General Básica hasta décimo.',
    matricula: info.matricula_inicial,
    pension: info.pension_inicial,
    icon: 'school',
  },
  {
    title: 'Bachillerato',
    description: 'Bachillerato en Ciencias y Bachillerato Técnico en Informática.',
    matricula: info.matricula_bachillerato,
    pension: info.pension_bachillerato,
    icon: 'graduation-cap',
  },
];

const requirements = [
  'Certificado de promoción (desde 5to en adelante).',
  '2 copias de cédula del estudiante y representante legal (a color).',
  '2 carpetas colgantes de cualquier color.',
  '1 carpeta de cartón con vincha.',
  '5 fotos tamaño carnet.',
  '1 separador de documentos.',
  'Valores cancelados (matrícula, 2 meses de pensión y libros).',
];

const requirementsNewStudents = new Set([
  '2 carpetas colgantes de cualquier color.',
  '1 carpeta de cartón con vincha.',
]);

const formatUSD = (value: number) => `$${value.toFixed(2)}`;
---

<MainLayout
  title="Matrícula y Pensiones"
  description={`${info.aviso} Consulta los requisitos y los costos de matrícula y pensión de la Unidad Educativa Fiscomisional 10 de Agosto.`}
>
  <PageHero
    eyebrow="Matrícula y Pensiones"
    breadcrumb="Matrícula y Pensiones"
    title={info.titulo}
    description={info.introduccion}
    image="/assets/fotos/IMG_5060.jpg"
    imageAlt="Estudiantes y docentes reunidos en el patio del colegio"
  />

  <!-- Estado del proceso, editado desde Decap CMS -->
  <section class="relative overflow-hidden bg-sun-100">
    <div class="absolute inset-0 bg-dot-grid opacity-40" aria-hidden="true"></div>
    <div class="container-site relative py-10 sm:py-14">
      <div class="grid gap-6 rounded-[2rem] border border-sun-300 bg-white p-6 shadow-xl shadow-brand-950/5 md:grid-cols-[auto_1fr] md:items-start md:p-9">
        <span
          class:list={[
            'flex h-16 w-16 items-center justify-center rounded-2xl sm:h-20 sm:w-20',
            estaAbierta ? 'bg-emerald-100 text-emerald-700' : 'bg-sun-400 text-brand-950',
          ]}
        >
          <Icon name={estaAbierta ? 'check' : 'clock'} class="h-7 w-7 sm:h-8 sm:w-8" />
        </span>

        <div>
          <div class="flex flex-wrap items-center gap-2.5">
            <span
              class:list={[
                'inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-[9px] font-extrabold uppercase tracking-[0.16em] text-white',
                estaAbierta ? 'bg-emerald-600' : 'bg-brand-700',
              ]}
            >
              <span class="relative flex h-1.5 w-1.5">
                <span class="absolute inline-flex h-full w-full rounded-full bg-white/70"></span>
                <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-white"></span>
              </span>
              {estaAbierta ? 'Matrículas abiertas' : 'Matrículas cerradas'}
            </span>
            <span class="text-[10px] font-extrabold uppercase tracking-[0.14em] text-stone-400">Estado actual</span>
          </div>

          <h2 class="mt-4 max-w-3xl text-2xl leading-tight sm:text-3xl">{info.aviso}</h2>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-stone-600 sm:text-base">{info.mensaje}</p>

          <div class="mt-6 flex flex-wrap gap-2.5">
            <a href={site.facebook} target="_blank" rel="noopener noreferrer" class="btn btn-primary !px-5 !py-2.5 text-xs">
              <Icon name="facebook" class="h-4 w-4" />
              Seguir en Facebook
            </a>
            <a href={site.tiktok} target="_blank" rel="noopener noreferrer" class="btn btn-secondary !px-5 !py-2.5 text-xs">
              <Icon name="tiktok" class="h-4 w-4" />
              Seguir en TikTok
            </a>
            <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="btn btn-secondary !px-5 !py-2.5 text-xs">
              <Icon name="instagram" class="h-4 w-4" />
              Seguir en Instagram
            </a>
            <a href="#valores" class="group inline-flex items-center gap-2 px-2 py-2.5 text-xs font-extrabold text-brand-700 transition hover:text-brand-900">
              Ver valores
              <Icon name="chevron-down" class="h-4 w-4 transition-transform group-hover:translate-y-0.5" />
            </a>
            <a href="#requisitos" class="group inline-flex items-center gap-2 px-2 py-2.5 text-xs font-extrabold text-brand-700 transition hover:text-brand-900">
              Ver requisitos
              <Icon name="chevron-down" class="h-4 w-4 transition-transform group-hover:translate-y-0.5" />
            </a>
          </div>
        </div>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {
          [
            { icon: 'shield-check', title: 'Requisitos', text: 'Revisa la documentación solicitada.' },
            { icon: 'award', title: 'Valores', text: 'Consulta matrícula y pensiones.' },
            { icon: 'map-pin', title: 'San Lorenzo', text: 'Esmeraldas, Ecuador.' },
          ].map((item) => (
            <div class="flex items-center gap-3 rounded-2xl border border-sun-200 bg-white/70 px-4 py-3.5">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white text-brand-700 shadow-sm">
                <Icon name={item.icon} class="h-4 w-4" />
              </span>
              <div>
                <p class="text-[10px] font-extrabold uppercase tracking-wide text-stone-700">{item.title}</p>
                <p class="mt-0.5 text-[11px] leading-snug text-stone-500">{item.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Costos de matrícula y pensión -->
  <section id="valores" class="scroll-mt-40 bg-white py-16 sm:py-20 lg:py-24">
    <div class="container-site">
      <SectionHeading
        eyebrow="Valores"
        title="Costos de matrícula y pensión"
        description="Los valores se organizan según el nivel educativo. Consulta el detalle correspondiente antes de realizar tu pago."
      />

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        {
          niveles.map((nivel, index) => (
            <article
              class="relative overflow-hidden rounded-[2rem] border border-stone-200 bg-white p-7 shadow-sm shadow-stone-900/5 transition duration-300 hover:border-brand-200 hover:shadow-lg sm:p-9"
              data-reveal
              style={`--reveal-delay: ${index * 90}ms`}
            >
              <div
                class:list={[
                  'absolute inset-x-0 top-0 h-1.5',
                  index === 0 ? 'bg-sun-400' : 'bg-brand-700',
                ]}
                aria-hidden="true"
              />

              <div class="flex items-start justify-between gap-4">
                <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
                  <Icon name={nivel.icon} class="h-6 w-6" />
                </span>
                <span class="rounded-full border border-stone-200 bg-stone-50 px-3 py-1.5 text-[9px] font-extrabold uppercase tracking-[0.14em] text-stone-500">
                  Nivel educativo
                </span>
              </div>

              <h2 class="mt-6 text-2xl sm:text-3xl">{nivel.title}</h2>
              <p class="mt-2 max-w-md text-sm leading-relaxed text-stone-500">{nivel.description}</p>

              <dl class="mt-7 divide-y divide-stone-200 border-y border-stone-200">
                <div class="flex items-end justify-between gap-4 py-5">
                  <div>
                    <dt class="text-sm font-extrabold text-stone-800">Matrícula</dt>
                    <p class="mt-1 text-[11px] text-stone-400">Valor correspondiente al nivel</p>
                  </div>
                  <dd class="font-display text-3xl font-semibold leading-none text-brand-700">
                    {formatUSD(nivel.matricula)}
                  </dd>
                </div>
                <div class="flex items-end justify-between gap-4 py-5">
                  <div>
                    <dt class="text-sm font-extrabold text-stone-800">Pensión mensual</dt>
                    <p class="mt-1 text-[11px] text-stone-400">Pago correspondiente a cada mes</p>
                  </div>
                  <dd class="font-display text-3xl font-semibold leading-none text-brand-700">
                    {formatUSD(nivel.pension)}
                  </dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>

      <div class="mt-6 flex flex-col gap-4 rounded-3xl border border-sun-200 bg-sun-50 p-6 sm:flex-row sm:items-start sm:p-7" data-reveal>
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sun-400 text-brand-950">
          <Icon name="info" class="h-5 w-5" />
        </span>
        <div>
          <h2 class="text-lg text-stone-900">Información importante</h2>
          <p class="mt-2 text-sm leading-relaxed text-stone-600">{info.nota_pago}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Requisitos -->
  <section id="requisitos" class="scroll-mt-40 bg-cream py-16 sm:py-20 lg:py-24">
    <div class="container-site">
      <SectionHeading
        eyebrow="Documentación"
        title="Requisitos generales"
        description={estaAbierta
          ? 'El proceso está habilitado. Reúne la documentación indicada para avanzar con tu solicitud.'
          : 'Prepara tu documentación con anticipación. Estos requisitos se solicitan cuando el periodo de matrículas esté habilitado.'}
      />

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {
          requirements.map((requirement, index) => (
            <article
              class="group relative flex items-start gap-4 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm shadow-stone-900/5 transition duration-300 hover:border-brand-200 hover:shadow-md sm:p-6"
              data-reveal
              style={`--reveal-delay: ${(index % 2) * 60}ms`}
            >
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-brand-100 bg-brand-50 text-xs font-extrabold text-brand-700 transition duration-300 group-hover:border-brand-700 group-hover:bg-brand-700 group-hover:text-white">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0">
                <p class="text-sm font-bold leading-relaxed text-stone-800 sm:text-[15px]">{requirement}</p>
                {
                  requirementsNewStudents.has(requirement) && (
                    <span class="mt-2.5 inline-flex items-center gap-1.5 rounded-full bg-sun-100 px-2.5 py-1 text-[9px] font-extrabold uppercase tracking-[0.1em] text-sun-800">
                      <Icon name="info" class="h-3 w-3" />
                      Solo estudiantes nuevos
                    </span>
                  )
                }
              </div>
              <Icon name="check" class="ml-auto hidden h-5 w-5 shrink-0 text-brand-200 sm:block" />
            </article>
          ))
        }
      </div>

      <div class="mt-6 flex flex-col gap-4 rounded-2xl border border-brand-100 bg-brand-50 p-5 sm:flex-row sm:items-center sm:p-6" data-reveal>
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-brand-700 shadow-sm">
          <Icon name="info" class="h-5 w-5" />
        </span>
        <p class="text-sm leading-relaxed text-stone-600">
          Los requisitos marcados como <strong class="font-extrabold text-stone-800">“Solo estudiantes nuevos”</strong> no aplican a quienes ya forman parte de la institución. Si tienes dudas, consulta nuestros canales oficiales antes de entregar documentación.
          <a href="#valores" class="ml-1 font-extrabold text-brand-700 underline decoration-brand-300 underline-offset-4 transition hover:text-brand-900">
            Consulta los valores de matrícula y pensiones.
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Canales oficiales -->
  <section class="bg-white py-16 sm:py-20">
    <div class="container-site">
      <div class="grid gap-8 rounded-[2rem] border border-stone-200 bg-cream p-7 shadow-sm shadow-stone-900/5 sm:p-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
        <div data-reveal>
          <span class="eyebrow">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-600" aria-hidden="true"></span>
            Mantente atento
          </span>
          <h2 class="mt-5 text-3xl leading-tight sm:text-4xl">Toda comunicación oficial se publicará por nuestros canales.</h2>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-stone-500 sm:text-base">
            Nuestros canales oficiales son Facebook, TikTok e Instagram. No utilizamos WhatsApp. Te recomendamos seguirnos para recibir información verificada sobre matrículas, requisitos y valores.
          </p>
          <p class="mt-4 flex items-center gap-2 text-xs font-bold text-stone-400">
            <Icon name="map-pin" class="h-4 w-4 text-brand-600" />
            {site.location}
          </p>
        </div>

        <div class="grid gap-3" data-reveal style="--reveal-delay: 100ms">
          <a
            href={site.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 rounded-2xl border border-stone-200 bg-white p-4 transition hover:border-brand-200 hover:bg-brand-50"
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-700 text-white">
              <Icon name="facebook" class="h-5 w-5" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-[9px] font-extrabold uppercase tracking-[0.14em] text-stone-400">Facebook oficial</span>
              <span class="mt-0.5 block text-sm font-extrabold text-stone-800">UEF 10 de Agosto</span>
            </span>
            <Icon name="arrow-up-right" class="h-4 w-4 text-stone-300 transition group-hover:text-brand-600" />
          </a>

          <a
            href={site.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 rounded-2xl border border-stone-200 bg-white p-4 transition hover:border-brand-200 hover:bg-brand-50"
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-stone-900 text-white">
              <Icon name="tiktok" class="h-5 w-5" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-[9px] font-extrabold uppercase tracking-[0.14em] text-stone-400">TikTok oficial</span>
              <span class="mt-0.5 block text-sm font-extrabold text-stone-800">@uef.10.de.agosto</span>
            </span>
            <Icon name="arrow-up-right" class="h-4 w-4 text-stone-300 transition group-hover:text-brand-600" />
          </a>

          <a
            href={site.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 rounded-2xl border border-stone-200 bg-white p-4 transition hover:border-brand-200 hover:bg-brand-50"
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-amber-400 via-pink-600 to-purple-700 text-white">
              <Icon name="instagram" class="h-5 w-5" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-[9px] font-extrabold uppercase tracking-[0.14em] text-stone-400">Instagram oficial</span>
              <span class="mt-0.5 block text-sm font-extrabold text-stone-800">@uef10deagosto</span>
            </span>
            <Icon name="arrow-up-right" class="h-4 w-4 text-stone-300 transition group-hover:text-brand-600" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Conoce las etapas académicas que acompañamos."
    description="Desde Educación Inicial hasta el Bachillerato, descubre la propuesta formativa de nuestra institución."
    primaryLabel="Ver oferta académica"
    primaryHref="/oferta"
    secondaryLabel="Ver estructura organizacional"
    secondaryHref="/estructura-organizacional"
  />
</MainLayout>
