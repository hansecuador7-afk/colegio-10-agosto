---
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/Icon.astro';
---

<MainLayout title="Página no encontrada" description="La página que buscas no existe o cambió de ubicación.">
  <section class="relative overflow-hidden bg-cream py-20 sm:py-28">
    <div class="absolute inset-0 bg-dot-grid opacity-50" aria-hidden="true"></div>
    <div class="absolute -right-32 top-0 h-96 w-96 rounded-full bg-sun-200/50 blur-3xl" aria-hidden="true"></div>
    <div class="container-site relative text-center">
      <p class="font-display text-[7rem] font-semibold leading-none text-brand-700 sm:text-[10rem]">404</p>
      <span class="eyebrow mt-2">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-600" aria-hidden="true"></span>
        Página no encontrada
      </span>
      <h1 class="mx-auto mt-5 max-w-2xl text-3xl sm:text-4xl">Esta página no está en nuestro jardín.</h1>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-stone-500 sm:text-base">
        Puede que el enlace haya cambiado o que la página ya no exista. Te invitamos a volver al inicio y seguir explorando.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">
          <Icon name="school" class="h-4 w-4" />
          Volver al inicio
        </a>
        <a href="/oferta" class="btn btn-secondary">Ver oferta académica</a>
      </div>
    </div>
  </section>
</MainLayout>
