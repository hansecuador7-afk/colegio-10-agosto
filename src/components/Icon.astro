const isSolid = name in solidIcons;
const paths = isSolid ? solidIcons[name] : lineIcons[name] ?? lineIcons.info;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={className}
  fill={isSolid ? 'currentColor' : 'none'}
  stroke={isSolid ? 'none' : 'currentColor'}
  stroke-width={isSolid ? undefined : strokeWidth}
  stroke-linecap={isSolid ? undefined : 'round'}
  stroke-linejoin={isSolid ? undefined : 'round'}
  aria-hidden="true"
  focusable="false"
  set:html={paths}
/>
