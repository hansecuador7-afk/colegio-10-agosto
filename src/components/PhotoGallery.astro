---
import Icon from './Icon.astro';
import type { Photo } from '../data/photos';
import { categories, categoryLabels, photos as allPhotos } from '../data/photos';

interface Props {
  photos?: Photo[];
}

const { photos = allPhotos } = Astro.props;

const countFor = (category: string) =>
  category === 'todas' ? photos.length : photos.filter((photo) => photo.category === category).length;

const pluralizePhotos = (count: number) => `${count} ${count === 1 ? 'fotografía' : 'fotografías'}`;
---

<div data-gallery>
  <div class="flex flex-col gap-4 border-b border-stone-200 pb-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="no-scrollbar -mx-5 flex gap-2 overflow-x-auto px-5 pb-1 sm:mx-0 sm:flex-wrap sm:px-0">
      {
        categories.map((category) => (
          <button
            type="button"
            class="filter-chip"
            aria-pressed={category.id === 'todas' ? 'true' : 'false'}
            data-filter={category.id}
            aria-controls="galeria-grid"
          >
            {category.label}
            <span class="inline-flex min-w-6 items-center justify-center rounded-full bg-stone-100 px-1.5 py-0.5 text-[10px] font-extrabold text-stone-500">
              {countFor(category.id)}
            </span>
          </button>
        ))
      }
    </div>

    <p class="shrink-0 text-xs font-semibold text-stone-400" aria-live="polite" data-gallery-count>
      {pluralizePhotos(photos.length)}
    </p>
  </div>

  <div id="galeria-grid" class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 xl:grid-cols-4">
    {
      photos.map((photo, index) => (
        <article
          class="gallery-item group relative overflow-hidden rounded-2xl bg-stone-100"
          data-category={photo.category}
          data-photo-item
        >
          <button
            type="button"
            class="relative block aspect-[4/5] w-full overflow-hidden text-left"
            aria-label={`Ampliar fotografía: ${photo.alt}`}
            data-photo
            data-full={photo.src}
            data-caption={photo.caption}
            data-alt={photo.alt}
            data-category-label={categoryLabels[photo.category]}
          >
            <img
              src={photo.thumb}
              alt={photo.alt}
              loading={index < 8 ? 'eager' : 'lazy'}
              decoding="async"
              class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105 group-focus-visible:scale-105"
            />
            <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-stone-950/80 via-stone-950/5 to-transparent" aria-hidden="true"></span>
            <span class="pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-between gap-2 p-3.5 sm:p-4">
              <span class="text-[11px] font-bold leading-snug text-white sm:text-xs">{photo.caption}</span>
              <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur transition group-hover:bg-sun-400 group-hover:text-brand-950">
                <Icon name="image" class="h-3.5 w-3.5" />
              </span>
            </span>
          </button>

          <span class="pointer-events-none absolute left-3 top-3 rounded-full border border-white/20 bg-stone-950/35 px-2.5 py-1 text-[8px] font-extrabold uppercase tracking-[0.14em] text-white backdrop-blur">
            {categoryLabels[photo.category]}
          </span>
        </article>
      ))
    }
  </div>
</div>

<dialog class="photo-dialog" aria-labelledby="photo-dialog-caption" data-dialog>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-4 px-4 py-4 sm:px-7 sm:py-6">
      <div class="flex items-center gap-3">
        <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-[10px] font-extrabold uppercase tracking-[0.16em] text-sun-300">
          Galería
        </span>
        <p class="text-[11px] font-bold tabular-nums text-white/45" data-dialog-counter></p>
      </div>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white transition hover:bg-white/15"
        aria-label="Cerrar visor de fotografías"
        data-dialog-close
      >
        <Icon name="x" class="h-5 w-5" />
      </button>
    </div>

    <div class="relative flex flex-1 items-center justify-center gap-2 px-3 pb-5 sm:gap-5 sm:px-7 sm:pb-7">
      <button
        type="button"
        class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white transition hover:bg-white/15 sm:h-12 sm:w-12"
        aria-label="Fotografía anterior"
        data-dialog-prev
      >
        <Icon name="chevron-left" class="h-5 w-5" />
      </button>

      <figure class="flex min-w-0 max-w-5xl flex-col items-center">
        <img
          data-dialog-image
          alt=""
          class="max-h-[65vh] w-auto max-w-full rounded-xl object-contain shadow-2xl shadow-black/50 sm:max-h-[70vh]"
        />
        <figcaption class="mt-4 max-w-2xl text-center">
          <p class="text-[9px] font-extrabold uppercase tracking-[0.18em] text-sun-300" data-dialog-category></p>
          <p id="photo-dialog-caption" class="mt-1 font-display text-lg leading-snug text-white sm:text-xl" data-dialog-caption></p>
        </figcaption>
      </figure>

      <button
        type="button"
        class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white transition hover:bg-white/15 sm:h-12 sm:w-12"
        aria-label="Fotografía siguiente"
        data-dialog-next
      >
        <Icon name="chevron-right" class="h-5 w-5" />
      </button>
    </div>
  </div>
</dialog>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-dialog]');

  if (gallery && dialog) {
    const triggers = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-photo]'));
    const items = Array.from(gallery.querySelectorAll<HTMLElement>('[data-photo-item]'));
    const filters = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const countLabel = gallery.querySelector<HTMLElement>('[data-gallery-count]');
    const dialogImage = dialog.querySelector<HTMLImageElement>('[data-dialog-image]');
    const dialogCaption = dialog.querySelector<HTMLElement>('[data-dialog-caption]');
    const dialogCategory = dialog.querySelector<HTMLElement>('[data-dialog-category]');
    const dialogCounter = dialog.querySelector<HTMLElement>('[data-dialog-counter]');
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-dialog-close]');
    const previousButton = dialog.querySelector<HTMLButtonElement>('[data-dialog-prev]');
    const nextButton = dialog.querySelector<HTMLButtonElement>('[data-dialog-next]');

    let currentTrigger: HTMLButtonElement | null = null;
    let visibleTriggers: HTMLButtonElement[] = [];
    let activeIndex = 0;

    const getVisibleTriggers = () =>
      triggers.filter((trigger) => {
        const item = trigger.closest<HTMLElement>('[data-photo-item]');
        return item ? !item.hidden : false;
      });

    const updateDialog = () => {
      const trigger = visibleTriggers[activeIndex];
      if (!trigger || !dialogImage) return;
      dialogImage.src = trigger.dataset.full ?? '';
      dialogImage.alt = trigger.dataset.alt ?? '';
      if (dialogCaption) dialogCaption.textContent = trigger.dataset.caption ?? '';
      if (dialogCategory) dialogCategory.textContent = trigger.dataset.categoryLabel ?? '';
      if (dialogCounter) {
        dialogCounter.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(visibleTriggers.length).padStart(2, '0')}`;
      }
    };

    const openDialog = (trigger: HTMLButtonElement) => {
      visibleTriggers = getVisibleTriggers();
      activeIndex = Math.max(0, visibleTriggers.indexOf(trigger));
      currentTrigger = trigger;
      updateDialog();
      document.body.style.overflow = 'hidden';
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
      closeButton?.focus();
    };

    const stepDialog = (direction: number) => {
      if (visibleTriggers.length === 0) return;
      activeIndex = (activeIndex + direction + visibleTriggers.length) % visibleTriggers.length;
      updateDialog();
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => openDialog(trigger));
    });

    previousButton?.addEventListener('click', () => stepDialog(-1));
    nextButton?.addEventListener('click', () => stepDialog(1));
    closeButton?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      currentTrigger?.focus();
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (event) => {
      if (!dialog.open) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        stepDialog(-1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        stepDialog(1);
      }
    });

    filters.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter ?? 'todas';

        filters.forEach((filterButton) => {
          filterButton.setAttribute('aria-pressed', String(filterButton === button));
        });

        items.forEach((item) => {
          item.hidden = filter !== 'todas' && item.dataset.category !== filter;
        });

        const visibleCount = getVisibleTriggers().length;
        if (countLabel) {
          countLabel.textContent = `${visibleCount} ${visibleCount === 1 ? 'fotografía' : 'fotografías'}`;
        }
      });
    });
  }
</script>
